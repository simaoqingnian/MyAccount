{
  "name": "奶油桃桃",
  "id": "peach",
  "date": "2026-11-10",
  "status": "implemented-android-0.3.0",
  "defaultTheme": "titanium",
  "colors": {
    "background": "#FFF9F2",
    "surface": "#FFFDFA",
    "textPrimary": "#49392F",
    "textSecondary": "#7D6A5B",
    "divider": "#EBDCD0",
    "balanceCard": "#F9DED0",
    "selected": "#F5C4B4",
    "apricot": "#F6DFC0",
    "pistachio": "#DCE8D6",
    "accentText": "#9B5145",
    "onAccent": "#49392F",
    "income": "#39764F",
    "error": "#A83D35"
  },
  "geometryDp": {
    "cardRadius": 22,
    "tileRadius": 13,
    "inputRadius": 10,
    "categoryIconBox": 40,
    "categoryColumns": 5,
    "minimumTouchTarget": 44,
    "listDividerPhysicalPixels": 1
  },
  "illustration": {
    "motif": "original-smiling-peach",
    "positions": [
      "balance-card-corner",
      "chart-summary-corner"
    ],
    "maximumPerScreen": 2,
    "animated": false
  },
  "themePreferenceProposal": {
    "storage": "SharedPreferences",
    "file": "appearance",
    "key": "theme",
    "values": [
      "titanium",
      "sage",
      "peach"
    ],
    "fallback": "titanium"
  },
  "restrictions": [
    "solid-readable-text",
    "no-illustration-over-amounts",
    "no-continuous-animation",
    "no-network-assets",
    "preserve-entry-state-on-theme-change",
    "no-ledger-schema-change"
  ]
}
